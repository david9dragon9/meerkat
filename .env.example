# Set exactly one of these. When several are present, Meerkat picks the first
# in this order: OpenAI, then Anthropic, then Fireworks.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FIREWORKS_API_KEY=

# Optional: force a provider regardless of which keys are set.
# MEERKAT_PROVIDER=anthropic

# Optional: pin a model tier. Defaults come from the active provider, so leave
# these unset unless you want a specific model.
# MEERKAT_PLANNER_MODEL=
# MEERKAT_CHEAP_MODEL=
# MEERKAT_MID_MODEL=
# MEERKAT_RESPONDER_MODEL=
